# ==============================================================================
# ION LIVE CHAT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
APP_NAME="ION Live Chat"
APP_ENV=production
APP_KEY=base64:XG8o0uT6kX9qX67b7uO1Q8Z3HlZ/tqfK1lI5jZ4rZ1A=
APP_DEBUG=false
APP_URL=http://localhost
FRONTEND_URL=http://localhost

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ion_livechat
DB_USERNAME=ion_user
DB_PASSWORD=ion_secret

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Queue & Cache
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Broadcasting & Laravel Reverb (WebSocket)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ionlivechat
REVERB_APP_KEY=ionlivechatkey
REVERB_APP_SECRET=ionlivechatsecret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Public Facing Client Reverb Configurations
PUBLIC_HOST=localhost
PUBLIC_PORT=80
PUBLIC_SCHEME=http

# HTTP Reverse Proxy Port
HTTP_PORT=80

# Auto Migrations & Seeders on Container Startup
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# Social Login (Google & Facebook OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/oauth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost/api/v1/auth/oauth/facebook/callback
