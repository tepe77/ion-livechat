# ==============================================================================
# ION BROADBAND LIVECHAT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
APP_NAME="ION Broadband Livechat"
APP_ENV=production
APP_KEY=base64:XG8o0uT6kX9qX67b7uO1Q8Z3HlZ/tqfK1lI5jZ4rZ1A=
APP_DEBUG=false
APP_URL=https://livechat.zayra.web.id
FRONTEND_URL=https://livechat.zayra.web.id

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ion_livechat
DB_USERNAME=ion_user
DB_PASSWORD=ion_secret

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Queue & Cache
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Broadcasting & Laravel Reverb (WebSocket)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ionlivechat
REVERB_APP_KEY=ionlivechatkey
REVERB_APP_SECRET=ionlivechatsecret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Public Facing Client Reverb Configurations (for HTTPS domain)
PUBLIC_HOST=livechat.zayra.web.id
PUBLIC_PORT=443
PUBLIC_SCHEME=https

# Internal Docker Gateway Port on Host VM (Proxied by Host NGINX)
HTTP_PORT=8888

# Auto Migrations & Seeders on Container Startup
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# Social Login (Google & Facebook OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://livechat.zayra.web.id/api/v1/auth/oauth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://livechat.zayra.web.id/api/v1/auth/oauth/facebook/callback

